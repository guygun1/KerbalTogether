<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KerbalTogether</AssemblyName>
    <KspRoot Condition="'$(KspRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Kerbal Space Program</KspRoot>
    <Managed>$(KspRoot)\KSP_x64_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(KspRoot)\GameData\000_Harmony\0Harmony.dll</HintPath><Private>false</Private></Reference>
